<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: the way to point the app at a different Murmur. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="change_address"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/change_address">
        <intent
            android:action="com.sfdxb7.murmur.CHANGE_ADDRESS"
            android:targetPackage="com.sfdxb7.murmur"
            android:targetClass="com.sfdxb7.murmur.MainActivity" />
    </shortcut>
</shortcuts>
